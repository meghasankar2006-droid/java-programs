import java.util.*;
public class Main{
    public static void main(String []args){
        Scanner sc=new Scanner(System.in);
        int n=sc.nextInt();
        ArrayList <Integer> li=new ArrayList<>();
        for(int i=0;i<n;i++){
            li.add(sc.nextInt());
        }
        for(int i=0;i<n;i++){
            int big=1;
            for(int j=i+1;j<n;j++){
                if(li.get(i)<li.get(j)){
                    big=0;
                    break;
                }
            }
            if(big==1){
                System.out.print(li.get(i)+" ");
            }
        }
    }
}
