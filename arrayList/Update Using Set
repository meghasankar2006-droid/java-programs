import java.util.*;
public class main{
    public static void main(String []args){
        Scanner sc=new Scanner(System.in);
        int n=sc.nextInt();
        ArrayList <Integer> list =new ArrayList<>();
        for(int i=0;i<n;i++){
            list.add(sc.nextInt());
        }
        int p=sc.nextInt();
        int x=sc.nextInt();
        list.set(p,x);
        for(int i=0;i<n;i++){
            System.out.print(list.get(i)+" ");
        }
    }
}
