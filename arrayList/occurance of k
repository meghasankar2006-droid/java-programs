import java.util.*;
public class main{
    public static void main(String []args){
        Scanner sc=new Scanner(System.in);
        int n=sc.nextInt();
        ArrayList <Integer> list =new ArrayList<>();
        for(int i=0;i<n;i++){
            list.add(sc.nextInt());
        }
        int k=sc.nextInt();
        int count=0;
        for(int i=0;i<n;i++){
            if(list.get(i)==k){
                count++;
            }
        }
        System.out.println(k+" appears "+count+" times.");
    }
}
